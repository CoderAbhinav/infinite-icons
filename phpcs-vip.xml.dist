<?xml version="1.0"?>
<ruleset name="Infinite Icons — WordPress VIP">
	<description>
		Checks the plugin against the WordPress VIP standards, so it stays
		deployable on managed platforms that enforce them. Runtime pack
		downloads are turned off on those hosts (see Downloader::downloads_supported);
		packs are expected to be committed into packs/ instead.
	</description>

	<file>src</file>
	<file>infinite-icons.php</file>
	<file>uninstall.php</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPressVIPMinimum"/>
	<rule ref="WordPress-VIP-Go"/>
</ruleset>
