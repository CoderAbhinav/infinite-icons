<?xml version="1.0"?>
<ruleset name="Infinite Icons">
	<description>Coding standards for the Infinite Icons plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/packs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="infinite-icons"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="infinite_icons"/>
				<element value="InfiniteIcons"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<!-- PSR-4 class files are named after the class, not in WordPress's class-*.php style. -->
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- A test method's name states what it asserts; a docblock would only repeat it. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- The bootstrap must use the variable and constant names the WordPress test suite expects. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<!-- The bootstrap uses the names the test suite expects; tests apply core hooks by name. -->
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Test doubles and fixtures legitimately use direct filesystem calls. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
